    "import numpy as np\n",
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "X = np.array([[25], [20], [15]]) \n",
    "y= np.array([5, 10, 15]) \n",
    "\n",
    "model = LinearRegression() \n",
    "model.fit(X, y) \n",
    "\n",
    "prediction = model.predict([[18]]) \n",
    "print(prediction[0])"
   ]
  }
